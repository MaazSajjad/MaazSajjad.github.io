---
import { ViewTransitions } from "astro:transitions";
import Nav from "../components/react/Nav";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props;
const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{fullTitle}</title>
    <ViewTransitions />
  </head>
  <body>
    <Nav client:load />
    <main class="page-enter" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </body>
</html>
