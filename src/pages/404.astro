---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="mx-auto max-w-3xl px-5 py-40 text-center">
    <p class="text-xs uppercase tracking-wideish text-clay">404</p>
    <h1 class="serif mt-3 text-5xl">This page has no yarn on it.</h1>
    <a href="/" class="mt-8 inline-flex rounded-full bg-ink px-6 py-3 text-sm text-paper">Back home</a>
  </section>
</BaseLayout>
