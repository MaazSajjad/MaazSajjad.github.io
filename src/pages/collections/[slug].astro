---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collections, getCollection } from "../../data/collections";
import { ImageReveal, Reveal } from "../../components/react/Motion";
import ChipList from "../../components/react/ChipList";

export function getStaticPaths() {
  return collections.map((item) => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;
const item = getCollection(slug!);
if (!item) throw new Error("Unknown collection");
---

<BaseLayout title={item.title} description={item.summary}>
  <section class="grid min-h-[80vh] md:grid-cols-2">
    <div class="relative min-h-[50vh] md:min-h-full">
      <ImageReveal client:load src={item.image} alt={item.title} className="absolute inset-0 h-full" imgClassName="h-full min-h-[50vh] md:min-h-screen" />
    </div>
    <div class="flex flex-col justify-end bg-paper px-5 py-16 md:px-12 md:py-24">
      <Reveal client:load instant>
        <p class="text-xs uppercase tracking-wideish text-clay">{item.kicker}</p>
        <h1 class="serif mt-3 text-5xl md:text-6xl">{item.title}</h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">{item.summary}</p>
      </Reveal>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-16 px-5 py-24 md:grid-cols-2 md:px-8">
    <div>
      <h2 class="serif text-3xl">Where it is used</h2>
      <ChipList client:visible items={item.uses} />
    </div>
    <div>
      <h2 class="serif text-3xl">What to specify</h2>
      <ul class="mt-6 space-y-4 text-muted">
        {item.notes.map((note) => (
          <li class="border-t border-line pt-4">{note}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-cream px-5 py-20 text-center md:px-8">
    <h2 class="serif text-4xl">Need a count, twist, or colourway?</h2>
    <p class="mx-auto mt-4 max-w-lg text-muted">Tell us the end use and we will come back with a sample path.</p>
    <a href="/contact" class="mt-8 inline-flex rounded-full bg-ink px-7 py-3 text-sm text-paper">Request a sample</a>
  </section>
</BaseLayout>
